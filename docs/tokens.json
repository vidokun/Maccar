      "dangerSoft": { "$value": "#FEF2F2", "$type": "color", "$description": "Subtle error banner surface" }
    },
    "dark": {
      "canvas": { "$value": "#0B0E14", "$type": "color", "$description": "60% dark neutral canvas" },
      "card": { "$value": "#131722", "$type": "color", "$description": "30% dark card surface" },
      "code": { "$value": "#1E2433", "$type": "color", "$description": "30% dark code block surface" },
      "border": { "$value": "#263042", "$type": "color", "$description": "30% dark subtle border" },
      "borderStrong": { "$value": "#334155", "$type": "color", "$description": "30% dark strong hover border" },
      "textPrimary": { "$value": "#F8FAFC", "$type": "color", "$description": "Dark primary text (>= 17:1)" },
      "textSecondary": { "$value": "#CBD5E1", "$type": "color", "$description": "Dark secondary text (>= 11:1)" },
      "textMuted": { "$value": "#94A3B8", "$type": "color", "$description": "Dark muted metadata text (>= 6:1)" },
      "accent": { "$value": "#38BDF8", "$type": "color", "$description": "10% hardware-link cyan primary accent" },
      "accentHover": { "$value": "#7DD3FC", "$type": "color", "$description": "Cyan hover state" },
      "onAccent": { "$value": "#0B0E14", "$type": "color", "$description": "Text on primary cyan CTA (>= 8.7:1)" },
      "accentSoft": { "$value": "#0C2D48", "$type": "color", "$description": "Dark subtle cyan surface tint" },
      "success": { "$value": "#4ADE80", "$type": "color", "$description": "Dark success foreground" },
      "successSoft": { "$value": "#052E16", "$type": "color", "$description": "Dark success surface tint" },
      "danger": { "$value": "#F87171", "$type": "color", "$description": "Dark error foreground" },
      "dangerSoft": { "$value": "#2A1215", "$type": "color", "$description": "Dark subtle error banner surface" }
    }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Inter", "Segoe UI", "Roboto", "sans-serif"],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["SF Mono", "JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "monospace"],
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "18px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" },
      "2xl": { "$value": "32px", "$type": "dimension" },
      "hero": { "$value": "44px", "$type": "dimension" }
    },
    "lineHeight": {
      "tight": { "$value": 1.15, "$type": "number" },
      "code": { "$value": 1.5, "$type": "number" },
      "normal": { "$value": 1.6, "$type": "number" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "300ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": [0.2, 0.8, 0.2, 1], "$type": "cubicBezier" }
    }
  }
