      "textMuted": { "$value": "#64748B", "$type": "color", "$description": "Muted metadata text on light canvas/card (>= 4.5:1)" },
      "accent": { "$value": "#0369A1", "$type": "color", "$description": "10% hardware-link cobalt primary accent" },
