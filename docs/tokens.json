      "code": { "$value": "#F1F5F9", "$type": "color", "$description": "30% inline & block code surface" },
      "border": { "$value": "#E2E8F0", "$type": "color", "$description": "30% subtle hairline border" },
      "borderStrong": { "$value": "#CBD5E1", "$type": "color", "$description": "30% hover & active border" },
      "textPrimary": { "$value": "#0F172A", "$type": "color", "$description": "Primary body and heading text (>= 16:1)" },
